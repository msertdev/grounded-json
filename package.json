{
  "name": "grounded-json-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build --workspace grounded-json && vinext build",
    "build:site": "vinext build",
    "build:package": "npm run build --workspace grounded-json",
    "test": "npm test --workspace grounded-json",
    "check": "npm run check --workspace grounded-json && npm run lint && npm run format:check && npm run build:site",
    "demo": "npm run build:package && node packages/grounded-json/dist/cli.js demo",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "shadcn": "4.22.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "packageManager": "npm@11.12.1"
}
